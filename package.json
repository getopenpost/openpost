{
  "name": "openpost",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/docs",
    "apps/marketing",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "_policy": "bun scripts/tasks.mjs check policy --policy-only",
    "browser:install": "playwright install chromium",
    "build": "bun scripts/tasks.mjs build",
    "capture:product-demos": "OPENPOST_CAPTURE_DEMOS=1 OPENPOST_APP_E2E_PORT=${OPENPOST_APP_E2E_PORT:-19281} playwright test --config tests/app/playwright.config.ts tests/app/product-demos.spec.ts --output tmp/product-demos/results --workers=1 && bun scripts/encode-product-demos.mjs",
    "render:launch-film": "bun apps/marketing/launch-film/render.mjs",
    "capture:product-screenshots": "OPENPOST_UPDATE_PRODUCT_SCREENSHOTS=1 OPENPOST_APP_E2E_PORT=${OPENPOST_APP_E2E_PORT:-19181} playwright test --config tests/app/playwright.config.ts tests/app/product-screenshots.spec.ts --workers=1 && bun scripts/optimize-readme-images.mjs && bun scripts/sync-assets.mjs",
    "check": "bun scripts/tasks.mjs check",
    "check:affected": "bun scripts/tasks.mjs check:affected",
    "check:changed": "bash scripts/changed-files-check.sh",
    "check:frontend:i18n": "bun run --filter @openpost/web generate:i18n",
    "check:frontend:types": "bun run check:frontend:i18n && OPENPOST_CHECK_PREPARED=1 bunx turbo run check --filter @openpost/web",
    "check:n8n": "bun scripts/tasks.mjs check n8n-package",
    "dev": "bun scripts/tasks.mjs dev",
    "doctor": "bash scripts/dev-doctor.sh",
    "format": "bun scripts/tasks.mjs format",
    "format:check": "bun scripts/tasks.mjs format:check",
    "fallow": "bun scripts/tasks.mjs fallow",
    "generate:social-assets": "bun assets/social/openpost/source/generate.mjs",
    "lint": "bun scripts/tasks.mjs lint",
    "postinstall": "bunx turbo run build --filter @openpost/ui",
    "release": "bun scripts/release.mjs",
    "test": "bun scripts/tasks.mjs test",
    "test:backend:pkg": "go test -tags dev",
    "test:file": "bun test",
    "verify": "bun scripts/tasks.mjs verify",
    "capture:mobile-screenshots": "bun scripts/capture-mobile-screenshots.mjs",
    "preflight": "bun scripts/tasks.mjs preflight",
    "_test:public-build": "bun test ./tests/build/generate-agent-surfaces.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.43",
    "@iconify/utils": "3.1.7",
    "@inlang/paraglide-js": "^3.1.0",
    "@napi-rs/canvas": "0.1.80",
    "@openpost/ui": "workspace:*",
    "@oxlint/plugins": "1.91.0",
    "@playwright/test": "^1.64.1",
    "@posthog/rollup-plugin": "1.4.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "braces": "3.0.3",
    "fallow": "3.38.1",
    "gifuct-js": "2.1.2",
    "js-yaml": "4.3.2",
    "knip": "6.44.1",
    "oxfmt": "0.61.0",
    "parse5": "7.3.0",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "turbo": "^2.11.10",
    "zod": "4.6.7"
  },
  "overrides": {
    "@sveltejs/kit": "2.70.3",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "cookie": "0.7.2",
    "devalue": "5.9.4",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.8",
    "follow-redirects": "1.16.1",
    "handlebars": "4.7.10",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "postcss-selector-parser": "7.1.6",
    "qs": "6.16.1",
    "serialize-javascript": "7.1.3",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "svelte": "5.57.3",
    "tar": "7.5.22",
    "undici": "7.30.1",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "vue": "3.5.42"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@fumadocs/api-docs@0.2.8": "patches/@fumadocs%2Fapi-docs@0.2.8.patch",
    "@asamuzakjp/css-color@3.2.0": "patches/@asamuzakjp%2Fcss-color@3.2.0.patch",
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  },
  "trustedDependencies": [
    "@openpost/web",
    "esbuild",
    "sharp",
    "vue-demi",
    "workerd"
  ]
}
