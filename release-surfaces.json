{
  "schema_version": 1,
  "surfaces": {
    "application": {
      "description": "Server, web and native applications, CLI, shared runtime packages, and application browser coverage",
      "prefixes": ["backend/", "cli/", "e2e-app/", "examples/", "frontend/", "mobile/", "packages/"]
    },
    "marketing": {
      "description": "Public marketing site, public social assets, and marketing browser coverage",
      "prefixes": [
        "e2e/",
        "marketing-site/",
        "packages/changelog/",
        "packages/legal-policy/",
        "packages/social-images/",
        "packages/social-preview/",
        "assets/social/"
      ],
      "paths": ["marketing-claims.json"]
    },
    "documentation": {
      "description": "Product, operator, contributor, policy, and generated documentation",
      "prefixes": ["docs-site/", "docs/", "licenses/", "packages/social-images/"],
      "paths": [
        "AGENTS.md",
        "CHANGELOG.md",
        ".github/CODE_OF_CONDUCT.md",
        ".github/CONTRIBUTING.md",
        "DESIGN.md",
        "PRODUCT.md",
        "README.md",
        ".github/SECURITY.md",
        "licenses/README.md"
      ]
    },
    "delivery": {
      "description": "Build, test, image, deployment, release, certification, and repository environment contracts",
      "prefixes": [
        ".github/",
        "changes/",
        "docker/",
        "provider-certification/",
        "scripts/",
        "tools/"
      ],
      "paths": [
        ".dockerignore",
        ".env.example",
        ".envrc",
        ".gitleaks.toml",
        ".oxfmtrc.json",
        "bun.lock",
        "bunfig.toml",
        "cloudflare/edge-plan.json",
        "compatibility-surfaces.json",
        "devenv.lock",
        "devenv.nix",
        "devenv.yaml",
        "docker-compose.yml",
        "knip.jsonc",
        "package.json",
        "release-surfaces.json",
        "turbo.json"
      ]
    },
    "launch": {
      "description": "Reviewable launch campaign templates and distribution evidence",
      "prefixes": ["docs/launch-kit/"]
    },
    "agent-tools": {
      "description": "Repository-owned agent instructions, skills, hooks, and design-audit tooling",
      "prefixes": [".agents/", ".codex/", ".impeccable/", "skills/"],
      "paths": [".github/copilot-instructions.md", "server.json", "skills-lock.json"]
    },
    "shared-assets": {
      "description": "Canonical assets copied into one or more shipped web surfaces",
      "prefixes": [
        "assets/ai-logos/",
        "assets/brand/",
        "assets/customer-logos/",
        "assets/logos/",
        "assets/postiz-socials/",
        "assets/screenshots/",
        "assets/star-history/",
        "assets/testimonial-portraits/"
      ]
    },
    "repository": {
      "description": "Repository behavior and licensing with no standalone runtime owner",
      "paths": [".gitattributes", ".gitignore", ".rgignore", "LICENSE"]
    }
  },
  "exemptions": [
    {
      "prefix": "references/",
      "reason": "Git-ignored source-reference checkout placeholders are not shipped or released"
    }
  ]
}
