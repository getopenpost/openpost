{
  "name": "@openpost/site",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:assets": "bun ../scripts/sync-assets.mjs --surface marketing",
    "sync:404": "bun scripts/sync-static-404.mjs",
    "check:404": "bun scripts/sync-static-404.mjs --check",
    "check:content": "bun scripts/check-comparison-evidence.mjs",
    "dev": "bun run sync:assets && bun run sync:404 && vite dev --host 0.0.0.0 --port 4322",
    "build": "bun run sync:assets && bun run sync:404 && vite build && bun run build:functions && bun scripts/check-routing-output.mjs && bun scripts/check-social-metadata-output.mjs",
    "build:functions": "bun run check:functions && wrangler pages functions build functions --outdir .wrangler/functions --project-directory .",
    "check:functions": "tsc --noEmit -p tsconfig.functions.json",
    "check:routing": "bun scripts/check-routing-output.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4322",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run check:404 && bun run check:content"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@inlang/paraglide-js": "^2.10.0",
    "@posthog/rollup-plugin": "1.4.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.18",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-vercel-og": "^0.1.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@openpost/changelog": "workspace:*",
    "@openpost/legal-policy": "workspace:*",
    "@openpost/social-images": "workspace:*",
    "@openpost/social-preview": "workspace:*",
    "@openpost/telemetry": "workspace:*",
    "clsx": "^2.1.1",
    "@lucide/svelte": "^0.577.0",
    "mode-watcher": "^1.1.0",
    "react": "^19.2.8",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2"
  }
}
