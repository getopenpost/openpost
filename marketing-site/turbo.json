{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/CHANGELOG.md",
        "$TURBO_ROOT$/frontend/messages/**",
        "$TURBO_ROOT$/frontend/project.inlang/settings.json",
        "$TURBO_ROOT$/frontend/src/lib/**",
        "!$TURBO_ROOT$/frontend/src/lib/paraglide/**",
        "$TURBO_ROOT$/provider-certification/public-claims.json",
        "$TURBO_ROOT$/scripts/asset-surfaces.mjs",
        "$TURBO_ROOT$/scripts/asset-surfaces.ts",
        "$TURBO_ROOT$/scripts/sync-assets.mjs",
        "$TURBO_ROOT$/scripts/posthog-source-maps.ts"
      ],
      "outputs": ["dist/**", ".wrangler/functions/**"],
      "env": ["VITE_POSTHOG_PROJECT_TOKEN", "VITE_POSTHOG_API_HOST", "VITE_POSTHOG_UI_HOST", "VITE_OPENPOST_ENVIRONMENT", "VITE_OPENPOST_VERSION", "VITE_OPENPOST_REVISION", "POSTHOG_SOURCEMAPS_ENABLED", "POSTHOG_PROJECT_ID", "POSTHOG_UI_HOST", "OPENPOST_RELEASE_VERSION", "GITHUB_SHA", "GITHUB_RUN_ID"]
    }
  }
}
