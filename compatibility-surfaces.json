{
  "schema_version": 1,
  "policy": {
    "minimum_sunset_days": 90,
    "minimum_stable_releases": 2,
    "required_consumer_classes": [
      "web",
      "cli",
      "mcp",
      "mcp-media",
      "n8n",
      "api"
    ],
    "telemetry_source": "Structured request logs expose the normalized route and a low-cardinality consumer hint; they are operational evidence, not authenticated caller identity.",
    "required_notice_channels": [
      "CHANGELOG.md",
      "OpenAPI deprecated marker",
      "migration documentation"
    ],
    "removal_rule": "A public surface may be removed only after its replacement and migration path are available, deprecation is announced, the minimum time and stable-release windows both pass, every consumer class has reviewed evidence, and no known use remains."
  },
  "entries": [
