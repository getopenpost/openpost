# OpenPost Configuration
# =============================================================================
# >>> Set OPENPOST_APP_URL BEFORE FIRST RUN. <<<
#
# Most other settings (OAuth callback URLs, WebAuthn RPID, CORS, the
# public media URL) are derived from it automatically. Leaving it at
# the placeholder value below will:
#   1. Make every provider OAuth callback round-trip fail with
#      `redirect_uri_mismatch` the first time a user tries to connect
#      an X / LinkedIn / Threads account.
#   2. Make WebAuthn passkey registration fail silently (the RPID
#      becomes `localhost` or `openpost.example.com`).
#   3. Make Threads media uploads return 403 if your public host
#      doesn't match the URL the binary advertises.
#
# The example value below is the binary's default. In `devenv shell`
# the value is overridden by `devenv.nix` to the same. Override it
# with the URL you actually serve OpenPost from in production.
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================
# Most variables loaded by the main config can also use a sibling *_FILE
# variable for Docker/Podman/Kubernetes/NixOS secrets. Adapter-only values
# such as META_GRAPH_API_VERSION and LINKEDIN_API_VERSION are exceptions.
# Example:
# OPENPOST_JWT_SECRET_FILE=/run/secrets/openpost-jwt-secret
# Direct variable values win over *_FILE values, so leave the direct variable
# unset when you want the file value to be used.
# Instance admins can also manage optional account, email, authentication,
# Studio, feedback, provider behavior, and provider-app values in
# Settings -> Instance -> Configuration. Environment values stay authoritative;
# encrypted admin values apply only when the matching variable is unset.
OPENPOST_PORT=8080
# selfhost keeps local-first defaults. cloud refuses to boot unless Postgres,
# S3-compatible media storage, and Whop billing are configured below.
OPENPOST_EDITION=selfhost
OPENPOST_DATABASE_DRIVER=sqlite
OPENPOST_DATABASE_PATH=file:openpost.db?cache=shared&mode=rwc
# Required when OPENPOST_EDITION=cloud or OPENPOST_DATABASE_DRIVER=postgres.
OPENPOST_DATABASE_URL=
OPENPOST_STORAGE_DRIVER=local
OPENPOST_MEDIA_PATH=./media
OPENPOST_MEDIA_URL=/media
# Required when OPENPOST_EDITION=cloud or OPENPOST_STORAGE_DRIVER=s3:
# region, bucket, access key, secret key, and public base URL. Set endpoint
# for R2 or S3-compatible providers outside AWS.
OPENPOST_S3_ENDPOINT=
OPENPOST_S3_REGION=
OPENPOST_S3_BUCKET=
OPENPOST_S3_ACCESS_KEY_ID=
OPENPOST_S3_SECRET_ACCESS_KEY=
# Required in cloud mode so provider media URLs are publicly reachable.
OPENPOST_S3_PUBLIC_BASE_URL=
OPENPOST_S3_FORCE_PATH_STYLE=false

# OpenPost Studio is enabled by default in launch builds. Set false for an
# operational rollback that keeps Media upload and library workflows available.
OPENPOST_STUDIO_ENABLED=true
# Optional base URL for the self-hosted background-removal model/WASM assets.
# The embedded frontend uses /studio-models when this is empty.
OPENPOST_STUDIO_MODEL_BASE_URL=

# Video Studio edits, records, analyzes, and exports locally by default.
OPENPOST_VIDEO_STUDIO_ENABLED=false
# Embedded local VAD and transcription files use /video-studio-models by default.
OPENPOST_VIDEO_MODEL_BASE_URL=
# Stock search stays off until at least one server-side provider key is configured.
OPENPOST_STOCK_MEDIA_ENABLED=false
OPENPOST_PEXELS_API_KEY=
OPENPOST_UNSPLASH_ACCESS_KEY=
OPENPOST_PIXABAY_API_KEY=

# Feedback is off unless all three values below are set. The destination stays
# server-side; the browser only sees the recipient label.
OPENPOST_FEEDBACK_ENABLED=false
OPENPOST_FEEDBACK_DESTINATION_URL=
OPENPOST_FEEDBACK_RECIPIENT=
OPENPOST_FEEDBACK_SUPPORT_URL=https://github.com/rodrgds/openpost/issues/new

# Self-hosted instance admins can compare the running build with the latest
# stable OpenPost GitHub release. The check is read-only, cached, and disabled
# automatically in cloud mode.
OPENPOST_UPDATE_CHECK_ENABLED=true

# =============================================================================
# OpenPost Cloud Billing (Whop)
# =============================================================================
# Only needed for hosted/cloud deployments. The webhook endpoint is:
# ${OPENPOST_APP_URL}/api/v1/billing/whop/webhook
OPENPOST_WHOP_API_KEY=
OPENPOST_WHOP_API_BASE_URL=https://api.whop.com/api/v1
OPENPOST_WHOP_WEBHOOK_SECRET=
OPENPOST_WHOP_ACCOUNT_ID=
OPENPOST_WHOP_PRODUCT_ID=
OPENPOST_WHOP_CHECKOUT_RETURN_URL=
OPENPOST_WHOP_STARTER_MONTHLY_PLAN_ID=
OPENPOST_WHOP_STARTER_ANNUAL_PLAN_ID=
OPENPOST_WHOP_CREATOR_MONTHLY_PLAN_ID=
OPENPOST_WHOP_CREATOR_ANNUAL_PLAN_ID=
OPENPOST_WHOP_PRO_MONTHLY_PLAN_ID=
OPENPOST_WHOP_PRO_ANNUAL_PLAN_ID=
OPENPOST_WHOP_TEAM_MONTHLY_PLAN_ID=
OPENPOST_WHOP_TEAM_ANNUAL_PLAN_ID=
OPENPOST_WHOP_AGENCY_MONTHLY_PLAN_ID=
OPENPOST_WHOP_AGENCY_ANNUAL_PLAN_ID=

# Hosted X provider-cost guardrail. These values are millionths of a US dollar:
# 5000000 = $5.00, 15000 = $0.015, and 200000 = $0.20.
# This policy is active only in cloud mode when X is configured. A zero budget
# blocks hosted X publishing. Check current X pricing before changing prices.
OPENPOST_X_MONTHLY_BUDGET_MICROUSD=5000000
OPENPOST_X_POST_CREATE_COST_MICROUSD=15000
OPENPOST_X_POST_CREATE_WITH_URL_COST_MICROUSD=200000
OPENPOST_PROVIDER_USAGE_RETENTION_DAYS=180

# The URL the browser uses to reach the OpenPost UI. Used to derive OAuth
# callback URLs, the WebAuthn RPID, and CORS. No trailing slash.
# >>> REPLACE THIS with your public URL before first run. <<<
OPENPOST_APP_URL=http://localhost:8080
# Public-facing URL (for email links, WebAuthn origins, etc.). Falls back
# to OPENPOST_APP_URL if unset.
OPENPOST_PUBLIC_URL=http://localhost:8080
OPENPOST_EXTRA_CORS_ORIGINS=
OPENPOST_DISABLE_REGISTRATIONS=false
TZ=UTC

# Hosted account policy. Cloud mode requires legal URLs/versions, a support
# email, and email verification. Mail credentials are optional at startup;
# password registration stays unavailable until a provider is configured.
OPENPOST_LEGAL_ACCEPTANCE_REQUIRED=false
OPENPOST_TERMS_URL=
OPENPOST_PRIVACY_URL=
OPENPOST_TERMS_VERSION=
OPENPOST_PRIVACY_VERSION=
OPENPOST_SUPPORT_EMAIL=

# Signup verification and password-reset mail. Pick smtp, resend, or cloudflare.
# Cloud mode enables verification by default; self-hosted mode leaves it off.
OPENPOST_EMAIL_VERIFICATION_REQUIRED=false
OPENPOST_EMAIL_PROVIDER=
OPENPOST_EMAIL_FROM=
OPENPOST_RESEND_API_KEY=
OPENPOST_CLOUDFLARE_EMAIL_ACCOUNT_ID=
OPENPOST_CLOUDFLARE_EMAIL_API_TOKEN=
# SMTP uses STARTTLS on 587 or implicit TLS on 465. Plaintext SMTP is accepted
# only for loopback development servers. OPENPOST_SMTP_FROM remains a supported
# fallback for OPENPOST_EMAIL_FROM.
OPENPOST_SMTP_HOST=
OPENPOST_SMTP_PORT=587
OPENPOST_SMTP_USERNAME=
OPENPOST_SMTP_PASSWORD=
OPENPOST_SMTP_FROM=
OPENPOST_SMTP_TLS_MODE=starttls
OPENPOST_SMTP_SERVER_NAME=

# =============================================================================
# Authentication Secrets (GENERATE NEW ONES FOR PRODUCTION)
# =============================================================================
# Generate with: openssl rand -base64 32
OPENPOST_JWT_SECRET=change-this-jwt-secret-min-32-chars
OPENPOST_ENCRYPTION_KEY=change-this-encryption-key-32ch

# =============================================================================
# Google login, OpenID Connect login, and SSO (OPTIONAL)
# =============================================================================
# First-party Google login. Register this exact authorized redirect URI:
# ${OPENPOST_APP_URL}/api/v1/auth/oidc/google/callback
OPENPOST_AUTH_GOOGLE_CLIENT_ID=
# Prefer the file-backed form in production.
# OPENPOST_AUTH_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/openpost-google-client-secret

# Configure this instance-wide provider for Keycloak, Authentik, Okta, Entra
# ID, Google Workspace, or another OIDC issuer. Organization administrators can
# add hosted providers from Settings -> Single sign-on.
# Callback: ${OPENPOST_APP_URL}/api/v1/auth/oidc/instance/callback
OPENPOST_OIDC_ISSUER=
OPENPOST_OIDC_CLIENT_ID=
# Prefer the file-backed form in production.
# OPENPOST_OIDC_CLIENT_SECRET_FILE=/run/secrets/openpost-oidc-client-secret
OPENPOST_OIDC_NAME=Single sign-on
OPENPOST_OIDC_SCOPES=openid profile email
OPENPOST_OIDC_JIT_ENABLED=false
# Comma-separated exact issuer|subject pairs or email addresses allowed to
# become instance admin during environment-provider JIT provisioning.
OPENPOST_OIDC_BOOTSTRAP_ALLOWLIST=
# Existing instance-admin emails with a password and TOTP or passkey. These
# accounts can enter SSO-protected workspaces during an identity-provider outage.
OPENPOST_SSO_BREAK_GLASS_EMAILS=
OPENPOST_OIDC_NATIVE_CALLBACK_URL=openpost://oidc/callback

# =============================================================================
# Platform OAuth Credentials
# =============================================================================
# Configure only the platforms you need. Leave empty to disable a platform.
# Each *_REDIRECT_URI below is OPTIONAL — if you leave it blank, OpenPost
# derives the correct value from OPENPOST_APP_URL. Only set it explicitly
# when your callback URL is different (e.g. behind a proxy or on a path).

# -----------------------------------------------------------------------------
# X/Twitter OAuth
# Get credentials from: https://developer.twitter.com/en/portal/dashboard
# Default redirect: ${OPENPOST_APP_URL}/api/v1/accounts/x/callback
# Required scopes: tweet.read, tweet.write, users.read, offline.access
# -----------------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Mastodon OAuth (supports multiple instances)
# Create an app on each instance: Settings > Development > New Application
# Required scopes: read, write
#
# MASTODON_REDIRECT_URI is special: it uses the OOB flow by default (the
# 'urn:ietf:wg:oauth:2.0:oob' scheme), which doesn't need a real callback
# URL. Only override this if you have a custom callback set up.
# -----------------------------------------------------------------------------
MASTODON_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
MASTODON_SERVERS=[]

# -----------------------------------------------------------------------------
# Bluesky (App Passwords)
# No setup needed - just use your handle and app password from Bluesky settings.
# Settings > App Passwords > Create App Password
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# LinkedIn OAuth
# Get credentials from: https://www.linkedin.com/developers/apps
# Default redirect: ${OPENPOST_APP_URL}/api/v1/accounts/linkedin/callback
# Required scopes: openid, profile, w_member_social
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
OPENPOST_DISABLE_LINKEDIN_THREAD_REPLIES=false
# Enable only after LinkedIn approves rw_organization_admin,
# w_organization_social, and r_organization_social for this app.
OPENPOST_LINKEDIN_ORGANIZATIONS_ENABLED=false

# -----------------------------------------------------------------------------
# Threads OAuth (Meta Graph API)
# Get credentials from: https://developers.facebook.com/
# Create a Business app and add Threads API product
# Default redirect: ${OPENPOST_APP_URL}/api/v1/accounts/threads/callback
# Required scopes: threads_basic, threads_content_publish
#
# IMPORTANT: Threads requires HTTPS for OAuth redirects!
# For local development, expose port 8080 over HTTPS (e.g. ngrok http 8080).
# -----------------------------------------------------------------------------
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Structured provider apps
# Use this for provider apps that do not have legacy env-var triples.
# The same apps can be added in Settings -> Instance -> Configuration. Entries
# defined here stay read-only in the UI and override matching database rows.
#
# Example:
# OPENPOST_PROVIDER_APPS=[
#   {"provider":"facebook","client_id":"your-meta-app-id","client_secret":"your-meta-app-secret"},
#   {"provider":"instagram","client_id":"your-meta-app-id","client_secret":"your-meta-app-secret"},
#   {"provider":"tiktok","client_id":"your-tiktok-client-key","client_secret":"your-tiktok-client-secret"},
#   {"provider":"youtube","client_id":"your-google-oauth-client-id","client_secret":"your-google-oauth-client-secret"}
# ]
#
# Optional Meta Graph API version override for Meta Graph adapters.
META_GRAPH_API_VERSION=v25.0
# Facebook default redirect: ${OPENPOST_APP_URL}/api/v1/accounts/facebook/callback
# Facebook required scopes: pages_show_list, pages_read_engagement, pages_manage_posts
# Instagram default redirect: ${OPENPOST_APP_URL}/api/v1/accounts/instagram/callback
# Instagram required scopes: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement, business_management
# TikTok default redirect: ${OPENPOST_APP_URL}/api/v1/accounts/tiktok/callback
# TikTok required scopes: user.info.basic, user.info.profile, video.publish, video.upload
# YouTube default redirect: ${OPENPOST_APP_URL}/api/v1/accounts/youtube/callback
# YouTube required scopes: userinfo.profile, userinfo.email, youtube.readonly, youtube.upload
# Facebook, Instagram, and TikTok require HTTPS public media URLs for media publishing.
# -----------------------------------------------------------------------------
