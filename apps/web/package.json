{
	"name": "@openpost/web",
	"private": true,
	"type": "module",
	"scripts": {
		"assets:sync": "bun ../../scripts/sync-assets.mjs --surface frontend && bun ../../scripts/sync-static-ui.mjs",
		"dev": "bun run assets:sync && vite dev",
		"build": "bun run assets:sync && node ../../scripts/frontend-vite-build.mjs && bun ../../scripts/generate-app-route-manifest.mjs --output-directory build && bun ../../scripts/precompress-static.mjs --directory build && bun ../../scripts/immutable-frontend-assets.mjs web",
		"package": "bun ../../scripts/package-frontend.mjs",
		"preview": "vite preview",
		"generate:i18n": "paraglide-js compile --project ./project.inlang",
		"generate:theme-icons": "bun ../../scripts/generate-theme-icon-packs.mjs",
		"check:i18n": "bun ../../scripts/check-i18n.mjs",
		"check:theme-icons": "bun ../../scripts/generate-theme-icon-packs.mjs --check",
		"check:types": "openapi-typescript openapi.json -o ../../packages/api-contract/src/schema.d.ts --check",
		"check": "bun run check:i18n && bun run check:theme-icons && if [ \"${OPENPOST_CHECK_PREPARED:-0}\" != 1 ]; then bun run generate:i18n; fi && bun run check:types && bun run sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "bun run generate:i18n && bun run sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint:oxlint": "oxlint .",
		"lint:svelte": "eslint 'src/**/*.svelte' 'src/**/*.svelte.{ts,js}'",
		"test": "bun run sync && vitest run --project server && bun run test:browser && bun run test:production",
		"test:browser": "node scripts/component-browser-tests.mjs",
		"test:watch": "bun run sync && vitest",
		"test:server": "bun run sync && vitest run --project server",
		"generate:types": "openapi-typescript openapi.json -o ../../packages/api-contract/src/schema.d.ts",
		"sync": "svelte-kit sync",
		"test:production": "NODE_ENV=production vitest run --mode production --project client src/lib/video-editor/components/preview-transcript.production.svelte.test.ts src/lib/video-editor/components/preview-cut.svelte.test.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
