{
  "name": "mobile",
  "version": "0.2.69",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "env -u CC -u CXX -u LD -u AR -u NM -u STRIP -u RANLIB expo run:ios",
    "lint": "expo lint",
    "test": "bun test src plugins",
    "check": "bun run check:source && bunx expo-doctor",
    "prebuild:android": "CI=1 NODE_ENV=production expo prebuild --platform android --clean --no-install",
    "build:android:apk": "bun run prebuild:android && NODE_ENV=production ./android/gradlew -p android --no-daemon --max-workers=2 :app:assembleRelease -PreactNativeArchitectures=arm64-v8a -PopenpostDebugSigning=true",
    "build:android:candidate": "bun run prebuild:android && NODE_ENV=production ./android/gradlew -p android --no-daemon --max-workers=2 --build-cache :app:assembleRelease",
    "generate:themes": "bun ../../scripts/generate-native-theme-builtins.ts",
    "check:themes": "bun ../../scripts/generate-native-theme-builtins.ts --check",
    "check:platform-marks": "bun ../../scripts/generate-native-platform-marks.mjs --check",
    "check:source": "bunx tsc --noEmit && expo lint && bun test src plugins && bun run check:themes && bun run check:platform-marks"
  },
  "dependencies": {
    "@asamuzakjp/css-color": "3.2.0",
    "@expo/ui": "~57.0.26",
    "@noble/hashes": "^2.4.0",
    "@openpost/api-contract": "file:../../packages/api-contract",
    "@openpost/dither": "file:../../packages/dither",
    "@openpost/platform-text": "file:../../packages/platform-text",
    "@openpost/query-catalog": "file:../../packages/query-catalog",
    "@openpost/telemetry": "file:../../packages/telemetry",
    "@openpost/video-project": "file:../../packages/video-project",
    "@react-native-community/datetimepicker": "9.1.0",
    "@swmansion/react-native-bottom-sheet": "0.16.2",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/react-query": "5.102.8",
    "expo": "~57.0.31",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "htmlparser2": "10.0.0",
    "openapi-fetch": "^0.17.0",
    "posthog-react-native": "^4.81.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-html": "1.1.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "@types/react": "~19.2.2",
    "eslint": "9",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-constants": "$expo-constants",
    "expo-linking": "$expo-linking",
    "source-map-js": "1.2.2"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "braces@3.0.3": "../../patches/braces@3.0.3.patch",
    "expo-modules-core@57.0.24": "patches/expo-modules-core@57.0.24.patch",
    "react-native-enriched-html@1.1.1": "patches/react-native-enriched-html@1.1.1.patch"
  }
}
