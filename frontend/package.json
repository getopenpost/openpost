{
	"name": "@openpost/web",
	"private": true,
	"type": "module",
	"scripts": {
		"sync:assets": "bun ../scripts/sync-assets.mjs --surface frontend",
		"generate:app-assets:android": "bun run sync:assets && capacitor-assets generate --assetPath assets --android --iconBackgroundColor '#b74c05' --splashBackgroundColor '#0f0f10'",
		"configure:camera": "bun ../scripts/configure-capacitor-camera.mjs",
		"dev": "bun run sync:assets && vite dev",
		"build": "bun run sync:assets && bun run generate:i18n:build && node ../scripts/frontend-vite-build.mjs && bun ../scripts/generate-app-route-manifest.mjs --output-directory build && bun ../scripts/precompress-static.mjs --directory build",
		"package:backend": "bun ../scripts/package-frontend.mjs",
		"build:capacitor": "bun run sync:assets && bun run generate:i18n:build && node ../scripts/frontend-vite-build.mjs --app-mode=capacitor && cap sync android && bun run configure:camera && bun run generate:app-assets:android",
		"preview": "vite preview",
		"generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules --is-server \"import.meta.env?.SSR ?? typeof window === 'undefined'\"",
		"generate:i18n:build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure message-modules --is-server \"import.meta.env?.SSR ?? typeof window === 'undefined'\"",
		"check:i18n": "bun ../scripts/check-i18n.mjs",
		"generate:artifacts": "bun run generate:i18n && bun run generate:types",
		"check:types": "openapi-typescript openapi.json -o src/lib/api/types.d.ts --check",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run check:i18n && bun run generate:i18n && bun run check:types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run",
		"generate:types": "openapi-typescript openapi.json -o src/lib/api/types.d.ts"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.4.2",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "^2.10.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^0.577.0",
		"@posthog/rollup-plugin": "1.4.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/canvas-confetti": "^1.9.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"remixicon-svelte": "^0.0.5",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vite-plugin-pwa": "^1.1.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@capacitor/android": "^8.3.0",
		"@capacitor/app": "^8.1.0",
		"@capacitor/browser": "^8.0.4",
		"@capacitor/core": "^8.3.0",
		"@capacitor/splash-screen": "^8.0.1",
		"@capacitor/status-bar": "^8.0.2",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/geist": "^5.2.8",
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@huggingface/transformers": "3.8.1",
		"@imgly/background-removal": "1.7.0",
		"@noble/hashes": "1.8.0",
		"@openpost/social-preview": "workspace:*",
		"@openpost/telemetry": "workspace:*",
		"@openpost/video-project": "workspace:*",
		"@paddle/paddle-js": "^1.6.4",
		"@tanstack/table-core": "^8.21.3",
		"bits-ui": "^2.16.3",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"cuelume": "0.1.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"estree-walker": "2.0.2",
		"fabric": "7.4.0",
		"fflate": "0.8.2",
		"html-to-image": "^1.11.13",
		"layerchart": "2.0.0-next.48",
		"mediabunny": "^1.51.0",
		"mode-watcher": "^1.1.0",
		"onnxruntime-web": "1.21.0",
		"openapi-fetch": "^0.17.0",
		"svelte-reorderable-list": "^1.0.5",
		"svelte-sonner": "^1.1.1",
		"svelte-toolbelt": "0.10.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2"
	}
}
