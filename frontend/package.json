{
	"name": "@openpost/web",
	"private": true,
	"type": "module",
	"scripts": {
		"assets:sync": "bun ../scripts/sync-assets.mjs --surface frontend",
		"dev": "bun run assets:sync && vite dev",
		"build": "bun run assets:sync && bun run generate:i18n:build && node ../scripts/frontend-vite-build.mjs && bun ../scripts/generate-app-route-manifest.mjs --output-directory build && bun ../scripts/precompress-static.mjs --directory build && bun ../scripts/immutable-frontend-assets.mjs web",
		"package": "bun ../scripts/package-frontend.mjs",
		"preview": "vite preview",
		"generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie globalVariable preferredLanguage baseLocale --output-structure locale-modules --is-server \"import.meta.env?.SSR ?? typeof window === 'undefined'\"",
		"generate:i18n:build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie globalVariable preferredLanguage baseLocale --output-structure message-modules --is-server \"import.meta.env?.SSR ?? typeof window === 'undefined'\"",
		"check:i18n": "bun ../scripts/check-i18n.mjs",
		"check:types": "openapi-typescript openapi.json -o src/lib/api/types.d.ts --check",
		"check": "bun run check:i18n && if [ \"${OPENPOST_CHECK_PREPARED:-0}\" != 1 ]; then bun run generate:i18n; fi && bun run check:types && bun run sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint:oxlint": "oxlint .",
		"lint:svelte": "eslint 'src/**/*.svelte' 'src/**/*.svelte.{ts,js}'",
		"test": "bun run sync && vitest run",
		"test:watch": "bun run sync && vitest",
		"test:server": "bun run sync && vitest run --project server",
		"generate:types": "openapi-typescript openapi.json -o src/lib/api/types.d.ts",
		"generate:mobile-types": "openapi-typescript openapi.json -o ../mobile/src/lib/api/schema.d.ts",
		"sync": "svelte-kit sync"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "^2.10.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^0.577.0",
		"@oxlint/plugins": "1.78.0",
		"@posthog/rollup-plugin": "1.4.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/canvas-confetti": "^1.9.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.10",
		"@webgpu/types": "^0.1.72",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"openapi-typescript": "^7.13.0",
		"oxlint": "1.78.0",
		"playwright": "^1.58.2",
		"prettier-plugin-svelte": "^3.4.1",
		"remixicon-svelte": "^0.0.5",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^8.2.1",
		"vite-plugin-pwa": "^1.1.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/geist": "^5.2.8",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/inter-tight": "^5.2.8",
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/orbitron": "^5.2.8",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@fontsource/anton": "^5.2.8",
		"@fontsource/bebas-neue": "^5.2.8",
		"@fontsource/roboto": "^5.3.0",
		"@fontsource/roboto-slab": "^5.3.0",
		"@huggingface/transformers": "4.1.0",
		"@iconify-json/fluent-emoji-flat": "1.2.5",
		"@iconify/types": "2.0.0",
		"@iconify/utils": "3.1.4",
		"@imgly/background-removal": "1.7.0",
		"@lottiefiles/dotlottie-web": "0.76.0",
		"@mediabunny/ac3": "1.54.0",
		"@mediabunny/prores": "1.54.0",
		"@noble/hashes": "1.8.0",
		"@openpost/plan-catalog": "workspace:*",
		"@openpost/social-preview": "workspace:*",
		"@openpost/telemetry": "workspace:*",
		"@paddle/paddle-js": "^1.6.4",
		"@tanstack/table-core": "^8.21.3",
		"ai-music-js": "0.5.0",
		"bits-ui": "2.19.0",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"cuelume": "0.2.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"estree-walker": "2.0.2",
		"fabric": "7.4.0",
		"fflate": "0.8.2",
		"html-to-image": "^1.11.13",
		"kokoro-js": "1.2.1",
		"layerchart": "2.0.0-next.48",
		"mediabunny": "1.54.0",
		"mode-watcher": "^1.1.0",
		"onnxruntime-web": "1.26.0-dev.20260410-5e55544225",
		"openapi-fetch": "^0.17.0",
		"svelte-reorderable-list": "^1.0.5",
		"svelte-sonner": "^1.1.1",
		"svelte-toolbelt": "0.10.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"zod": "^4.4.3"
	}
}
