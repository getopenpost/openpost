{
  "name": "mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "env -u CC -u CXX -u LD -u AR -u NM -u STRIP -u RANLIB expo run:ios",
    "lint": "expo lint",
    "test": "bun test src plugins",
    "check": "bunx tsc --noEmit && expo lint && bunx expo-doctor && bun test src plugins",
    "prebuild:android": "CI=1 NODE_ENV=production expo prebuild --platform android --clean --no-install",
    "build:android:apk": "bun run prebuild:android && NODE_ENV=production ./android/gradlew -p android --no-daemon --max-workers=2 :app:assembleRelease -PreactNativeArchitectures=arm64-v8a -PopenpostDebugSigning=true",
    "build:android:candidate": "bun run prebuild:android && NODE_ENV=production ./android/gradlew -p android --no-daemon --max-workers=2 :app:assembleRelease",
    "generate:api": "openapi-typescript ../frontend/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@swmansion/react-native-bottom-sheet": "0.16.2",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "@types/react": "~19.2.2",
    "eslint": "9",
    "eslint-config-expo": "~57.0.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-constants": "$expo-constants",
    "expo-linking": "$expo-linking"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "expo-modules-jsi@57.0.6": "patches/expo-modules-jsi@57.0.6.patch",
    "expo-modules-core@57.0.14": "patches/expo-modules-core@57.0.14.patch"
  }
}
